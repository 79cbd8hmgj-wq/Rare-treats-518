---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/content";
---

<BaseLayout title="Contact" description="Contact Rare Treats 518 in Troy, New York through its official Instagram account.">
  <section class="page-hero contact-hero">
    <div class="site-shell hero-grid">
      <div>
        <p class="eyebrow">Contact Rare Treats 518</p>
        <h1>The next order starts with a direct message.</h1>
        <p class="lede">Instagram is the best place to ask about custom orders, current treats, and upcoming market dates.</p>
      </div>
      <a class="contact-card" href={site.social.instagram} target="_blank" rel="noreferrer">
        <span>Instagram</span>
        <strong>@raretreats518</strong>
        <p>Order questions, current treats, and market updates</p>
        <i>Open profile →</i>
      </a>
    </div>
  </section>

  <section class="section-tight contact-notes">
    <div class="site-shell notes-grid">
      <article><span>01</span><h2>For custom orders</h2><p>Include the occasion, date, quantity, treat ideas, and ingredient questions.</p><a href="/custom-orders">See the full checklist →</a></article>
      <article><span>02</span><h2>For market updates</h2><p>Follow the social feed for confirmed dates, event menus, and limited seasonal announcements.</p><a href="/markets">Learn about market days →</a></article>
      <article><span>03</span><h2>For general questions</h2><p>Review the FAQ before messaging for quick answers about ordering, payment, pickup, ingredients, and changes.</p><a href="/faq">Read the FAQ →</a></article>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(20rem, .65fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
  }

  .contact-card {
    display: block;
    padding: clamp(1.7rem, 5vw, 3.3rem);
    border-radius: 2rem;
    background: linear-gradient(145deg, var(--blueberry), #4a376c);
    color: white;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 180ms ease;
  }

  .contact-card:hover {
    transform: translateY(-4px) rotate(-1deg);
  }

  .contact-card span {
    color: var(--aqua);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .contact-card strong {
    display: block;
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .contact-card p {
    margin-top: 1.2rem;
    color: rgba(255,255,255,.68);
  }

  .contact-card i {
    font-size: .85rem;
    font-style: normal;
    font-weight: 800;
  }

  .contact-notes {
    background: rgba(255,255,255,.58);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .notes-grid article {
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--line);
  }

  .notes-grid article:last-child {
    border-right: 0;
  }

  .notes-grid span {
    color: var(--blush-deep);
    font-size: .72rem;
    font-weight: 850;
  }

  .notes-grid h2 {
    margin: 4rem 0 .8rem;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
  }

  .notes-grid a {
    font-size: .84rem;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .hero-grid,
    .notes-grid {
      grid-template-columns: 1fr;
    }

    .notes-grid article {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .notes-grid article:last-child {
      border-bottom: 0;
    }

    .notes-grid h2 {
      margin-top: 2rem;
    }
  }
</style>
