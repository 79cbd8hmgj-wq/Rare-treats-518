---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/content";
---

<BaseLayout title="Contact" description="Contact Rare Treats 518 in Troy, New York through Instagram or Facebook.">
  <section class="page-hero contact-hero">
    <div class="site-shell hero-grid">
      <div>
        <p class="eyebrow">Contact Rare Treats 518</p>
        <h1>Send me a message.</h1>
        <p class="lede">Instagram is the best place for custom orders. You can also follow Rare Treats 518 on Facebook for new treats and market updates.</p>
      </div>
      <div class="contact-options">
        <a class="contact-card" href={site.social.instagram} target="_blank" rel="noreferrer">
          <span>Instagram</span>
          <strong>@raretreats518</strong>
          <p>Custom orders, treat questions, and market updates</p>
          <i>Message me →</i>
        </a>
        {site.social.facebook && (
          <a class="facebook-card" href={site.social.facebook} target="_blank" rel="noreferrer">
            <div>
              <span>Facebook</span>
              <strong>Rare Treats 518</strong>
            </div>
            <i>Visit page →</i>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section-tight contact-notes">
    <div class="site-shell notes-grid">
      <article><span>01</span><h2>Ordering treats</h2><p>Send the date, how many people, what you’re celebrating, and what sounds good.</p><a href="/custom-orders">See what to include →</a></article>
      <article><span>02</span><h2>Finding a market</h2><p>Instagram and Facebook are where I post confirmed dates and what I’m bringing.</p><a href="/markets">See market information →</a></article>
      <article><span>03</span><h2>Quick questions</h2><p>The FAQ covers payment, pickup, ingredients, changes, and shipping.</p><a href="/faq">Read the FAQ →</a></article>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(20rem, .65fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
  }

  .contact-options {
    display: grid;
    gap: 0.85rem;
  }

  .contact-card {
    display: block;
    padding: clamp(1.7rem, 5vw, 3.3rem);
    border-radius: 2rem;
    background: linear-gradient(145deg, var(--blueberry), #4a376c);
    color: white;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 180ms ease;
  }

  .contact-card:hover,
  .facebook-card:hover {
    transform: translateY(-4px);
  }

  .contact-card span {
    color: var(--aqua);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .contact-card strong {
    display: block;
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .contact-card p {
    margin-top: 1.2rem;
    color: rgba(255,255,255,.68);
  }

  .contact-card i,
  .facebook-card i {
    font-size: .85rem;
    font-style: normal;
    font-weight: 800;
  }

  .facebook-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.84);
    color: var(--blueberry);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 180ms ease;
  }

  .facebook-card span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--blush-deep);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .facebook-card strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .contact-notes {
    background: rgba(255,255,255,.58);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .notes-grid article {
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--line);
  }

  .notes-grid article:last-child {
    border-right: 0;
  }

  .notes-grid span {
    color: var(--blush-deep);
    font-size: .72rem;
    font-weight: 850;
  }

  .notes-grid h2 {
    margin: 4rem 0 .8rem;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
  }

  .notes-grid a {
    font-size: .84rem;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .hero-grid,
    .notes-grid {
      grid-template-columns: 1fr;
    }

    .notes-grid article {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .notes-grid article:last-child {
      border-bottom: 0;
    }

    .notes-grid h2 {
      margin-top: 2rem;
    }
  }
</style>
