---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/content";
---

<BaseLayout title="About" description="Meet Misty Bensalah, owner of Rare Treats 518 in Troy, New York.">
  <section class="page-hero about-hero">
    <div class="site-shell hero-grid">
      <div>
        <p class="eyebrow">About Rare Treats 518</p>
        <h1>Hi, I’m Misty.</h1>
        <p class="lede">I’m the owner of Rare Treats 518, a small dessert business based in Troy, New York. I make homemade treats for custom orders, markets, and community events around the Capital Region.</p>
      </div>
      <div class="portrait-space" aria-label="Reserved space for an approved portrait of Misty">
        <div class="portrait-heart">♡</div>
        <span>Misty · Owner of Rare Treats 518</span>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="site-shell story-grid">
      <div class="story-title">
        <p class="eyebrow">Made in Troy, New York</p>
        <h2>Homemade treats, made personally.</h2>
      </div>
      <div class="story-copy">
        <p class="lede">Rare Treats 518 is my way of sharing the desserts I make with people around Troy, New York and the Capital Region.</p>
        <p>The menu changes with the season, the event, and the orders I’m working on. That means there’s usually something new to see.</p>
        <p>If you have a celebration coming up, send me the details. If you spot my table at a market, come say hi and see what I brought.</p>
      </div>
    </div>
  </section>

  <section class="section values-section">
    <div class="site-shell values-grid">
      <article><span>01</span><h2>Homemade</h2><p>I make the treats myself and keep the menu flexible.</p></article>
      <article><span>02</span><h2>Personal</h2><p>Custom orders start with your date, your idea, and a real conversation.</p></article>
      <article><span>03</span><h2>Local</h2><p>Rare Treats 518 is based in Troy, New York and shows up at events around the Capital Region.</p></article>
    </div>
  </section>

  <section class="section about-cta">
    <div class="site-shell cta-grid soft-panel">
      <div><p class="eyebrow">Follow along</p><h2>See what I’m making next.</h2></div>
      <a class="button" href={site.social.instagram} target="_blank" rel="noreferrer">Visit Instagram</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .75fr;
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
  }

  .portrait-space {
    display: grid;
    min-height: 28rem;
    place-items: center;
    align-content: center;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: 48% 48% 2rem 2rem;
    background: linear-gradient(145deg, rgba(117,213,208,.28), rgba(255,250,245,.7), rgba(246,154,190,.28));
    color: var(--blueberry-soft);
    text-align: center;
    box-shadow: var(--shadow);
  }

  .portrait-heart {
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 1;
  }

  .portrait-space span {
    max-width: 16rem;
    font-size: .78rem;
    font-weight: 750;
  }

  .story-section {
    background: rgba(255,255,255,.6);
  }

  .story-grid {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(2rem, 9vw, 8rem);
  }

  .story-title h2 {
    max-width: 10ch;
  }

  .story-copy {
    max-width: 42rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .values-grid article {
    min-height: 18rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--line);
  }

  .values-grid article:last-child {
    border-right: 0;
  }

  .values-grid span {
    color: var(--blush-deep);
    font-size: .72rem;
    font-weight: 850;
  }

  .values-grid h2 {
    margin: 4.5rem 0 .8rem;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .cta-grid h2 {
    max-width: 15ch;
    margin-bottom: 0;
  }

  @media (max-width: 780px) {
    .hero-grid,
    .story-grid,
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .portrait-space {
      min-height: 22rem;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .values-grid article {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .values-grid article:last-child {
      border-bottom: 0;
    }

    .values-grid h2 {
      margin-top: 2rem;
    }
  }
</style>
