---
import { publicNavigation, site } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <img src="/brand-mark.svg" width="48" height="48" alt="" />
        <span>{site.business.name}</span>
      </a>
      <p>{site.business.tagline}</p>
      <p class="muted">Based in {site.business.location}.</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {publicNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/policies">FAQ & policies</a></li>
      </ul>
    </div>
    <div>
      <h2>Follow</h2>
      <p>See current treats, market announcements, and limited releases on Instagram.</p>
      <a class="text-link" href={site.business.instagramUrl} target="_blank" rel="noreferrer">
        @{site.business.instagramHandle}
      </a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} {site.business.name}</span>
    <span>Website preview — ordering is not yet enabled.</span>
  </div>
</footer>
