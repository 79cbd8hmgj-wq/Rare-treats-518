---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={["brand-mark", { compact }]} href="/" aria-label="Rare Treats 518 home">
  <span class="heart" aria-hidden="true">
    <svg viewBox="0 0 100 92" role="presentation">
      <defs>
        <linearGradient id="heart-fill" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#75d5d0"></stop>
          <stop offset="0.52" stop-color="#f8efe8"></stop>
          <stop offset="1" stop-color="#f69abe"></stop>
        </linearGradient>
      </defs>
      <path d="M50 88 10 49C-10 29 1 3 23 3c12 0 21 7 27 17C56 10 65 3 77 3c22 0 33 26 13 46Z" fill="url(#heart-fill)" stroke="#271b45" stroke-width="3"></path>
      <path d="M16 51c12 9 23 16 34 29 11-13 22-20 34-29" fill="none" stroke="rgba(255,255,255,.72)" stroke-width="3" stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="words">
    <strong>Rare Treats</strong>
    <small>518 · Troy, NY</small>
  </span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--blueberry);
    text-decoration: none;
  }

  .heart {
    width: 2.8rem;
    flex: 0 0 auto;
    filter: drop-shadow(0 8px 18px rgba(91, 77, 120, 0.13));
  }

  .words {
    display: grid;
    line-height: 1;
  }

  strong {
    font-family: var(--font-display);
    font-size: 1.18rem;
    letter-spacing: -0.025em;
  }

  small {
    margin-top: 0.28rem;
    color: var(--blueberry-soft);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .compact .heart {
    width: 2.35rem;
  }

  @media (max-width: 420px) {
    .words small {
      display: none;
    }
  }
</style>
