---
import BrandMark from "./BrandMark.astro";
import { navigation } from "../data/content";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-shell header-inner">
    <BrandMark compact />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a class:list={{ active: currentPath.startsWith(item.href) }} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="header-cta" href="/custom-orders">Request an order</a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
      <div class="menu-panel">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/contact">Contact</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid rgba(39, 27, 69, 0.08);
    background: rgba(255, 250, 245, 0.84);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 5.25rem;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.6rem);
  }

  .desktop-nav a {
    position: relative;
    color: var(--blueberry-soft);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    background: var(--blush-deep);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition: 160ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--blueberry);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-cta {
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--blueberry);
    color: white;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-menu {
      display: block;
      position: relative;
    }

    summary {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      cursor: pointer;
      list-style: none;
      place-content: center;
      gap: 0.27rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: white;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary span {
      display: block;
      width: 1.05rem;
      height: 2px;
      border-radius: 999px;
      background: var(--blueberry);
    }

    .menu-panel {
      position: absolute;
      top: 3.2rem;
      right: 0;
      display: grid;
      min-width: 14rem;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 1rem;
      background: white;
      box-shadow: var(--shadow);
    }

    .menu-panel a {
      padding: 0.9rem 1rem;
      border-bottom: 1px solid rgba(39, 27, 69, 0.08);
      font-weight: 750;
      text-decoration: none;
    }

    .menu-panel a:last-child {
      border-bottom: 0;
    }
  }
</style>
