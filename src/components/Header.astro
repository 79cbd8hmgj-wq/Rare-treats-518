---
import { publicNavigation, site } from '../data/site';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.business.name} home`}>
      <img src="/brand-mark.svg" width="52" height="52" alt="" />
      <span>{site.business.name}</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {publicNavigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="button button-small" href="/custom-orders">Request an order</a>
  </div>
</header>
